{
    "name": "ivehicle/app",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpunit/phpunit": "^10.0",
        "phpmailer/phpmailer": "^7.1",
        "minishlink/web-push": "^11.0",
        "php-http/curl-client": "^2.4",
        "nyholm/psr7": "^1.8"
    },
    "config": {
        "platform": {
            "php": "8.2.4"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
